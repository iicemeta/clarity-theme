{
  "name": "clarity-theme",
  "type": "module",
  "version": "0.2.0-rc.1",
  "packageManager": "pnpm@12.4.1",
  "description": "Clarity Theme — 从 blog-v3 提取的可复用 Nuxt 4 Layer 博客主题",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/iicemeta/clarity-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iicemeta/clarity-theme.git"
  },
  "bugs": {
    "url": "https://github.com/iicemeta/clarity-theme/issues"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./config": {
      "types": "./src/config/index.d.mts",
      "default": "./src/config/index.mjs"
    },
    "./content": {
      "types": "./src/config/content.d.mts",
      "default": "./src/config/content.mjs"
    },
    "./img": {
      "types": "./src/img/index.d.mts",
      "default": "./src/img/index.mjs"
    },
    "./schema": {
      "types": "./src/config/schema.d.mts",
      "default": "./src/config/schema.mjs"
    }
  },
  "main": "./nuxt.config.ts",
  "files": [
    "!src/generated",
    "LICENSE",
    "README.md",
    "nuxt.config.ts",
    "package.json",
    "src"
  ],
  "engines": {
    "node": "^22.19 || ^24.11 || >=26"
  },
  "scripts": {
    "dev": "pnpm --dir playground dev",
    "build": "pnpm --dir playground build",
    "generate": "pnpm --dir playground generate",
    "lint": "eslint && stylelint \"src/**/*.{vue,scss}\" \"playground/app/**/*.vue\"",
    "lint:fix": "eslint --fix && stylelint \"src/**/*.{vue,scss}\" \"playground/app/**/*.vue\" --fix",
    "typecheck": "pnpm --dir playground typecheck",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "node scripts/verify-theme.mjs",
    "test:sync": "node --test tests/sync-upstream.test.mjs",
    "test:config": "node --test tests/config-schema.test.mjs",
    "test:transform-parity": "node --test tests/transform-parity.test.mjs",
    "test:migration": "node --test tests/migration-skill.test.mjs",
    "test:contract": "node scripts/test-compatibility.mjs --contract-only",
    "test:release": "pnpm verify && pnpm test:consumer && pnpm test:compatibility",
    "test:consumer": "node scripts/test-consumer.mjs",
    "test:file-generate": "node scripts/test-file-generate.mjs",
    "test:runtime-parity": "node scripts/test-runtime-parity.mjs",
    "test:visual-parity": "node scripts/test-visual-parity.mjs",
    "test:parity": "pnpm test:upstream-parity && pnpm test:runtime-parity && pnpm test:visual-parity",
    "test:compatibility": "node scripts/test-compatibility.mjs",
    "test:create": "pnpm --dir create-clarity-theme test",
    "test:create:e2e": "pnpm --dir create-clarity-theme test:e2e",
    "test:create:tarball": "pnpm --dir create-clarity-theme test:tarball",
    "test:registry-consumer": "node scripts/test-registry-consumer.mjs",
    "release:check": "node scripts/release-check.mjs",
    "sync:check": "node scripts/sync-upstream.mjs check",
    "sync:diff": "node scripts/sync-upstream.mjs diff",
    "sync:apply": "node scripts/sync-upstream.mjs apply",
    "sync:verify": "node scripts/sync-upstream.mjs verify",
    "test:upstream-parity": "node scripts/test-upstream-parity.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@bikariya/image-viewer": "^0.0.8",
    "@bikariya/modals": "^0.0.8",
    "@bikariya/shiki": "^0.0.8",
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/devicon": "^1.2.10",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/tabler": "^1.2.38",
    "@nuxt/content": "^3.16.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/seo": "^5.3.14",
    "@nuxtjs/sitemap": "^8.5.1",
    "@pinia/nuxt": "^1.0.2",
    "@shikijs/colorized-brackets": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "abcjs": "^6.7.0",
    "ci-info": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "es-toolkit": "^1.52.0",
    "fast-xml-builder": "^1.3.1",
    "jiti": "^2.3.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "nuxt-llms": "^0.2.0",
    "oxc-minify": "^0.148.0",
    "parse-domain": "^8.4.0",
    "pinia": "^4.0.3",
    "plain-shiki": "^0.3.2",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-reading-time": "^2.1.0",
    "sass-embedded": "^1.104.0",
    "shiki": "^4.4.3",
    "site-config-stack": "^4.2.3",
    "temporal-polyfill": "^1.0.4",
    "ufo": "^1.6.0",
    "unist-util-visit": "^5.1.0",
    "unplugin-yaml": "^4.2.1",
    "vfile": "^6.0.3",
    "vue-tippy": "^6.7.1",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/hints": "^1.1.4",
    "@stylistic/stylelint-plugin": "^5.2.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@zinkawaii/stylelint-config": "^0.5.2",
    "cspell": "^10.2.2",
    "eslint": "^10.10.0",
    "minimark": "0.2.0",
    "nuxt": "^4.5.2",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.1.3",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  }
}